from typing import Any

__version__: str

class Tensor:
    @staticmethod
    def zeros(shape: list[int], device: str = "cpu") -> Tensor: ...
    @staticmethod
    def from_list(data: list[float], shape: list[int], device: str = "cpu") -> Tensor: ...
    @staticmethod
    def from_numpy(array: Any, device: str = "cpu") -> Tensor: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def dtype(self) -> str: ...
    @property
    def device(self) -> str: ...
    @property
    def ndim(self) -> int: ...
    def numel(self) -> int: ...
    def to(self, device: str) -> Tensor: ...
    def tolist(self) -> list[float]: ...
    def numpy(self) -> Any: ...
    def __repr__(self) -> str: ...

class Variable:
    def __init__(self, tensor: Tensor) -> None: ...
    @staticmethod
    def constant(tensor: Tensor) -> Variable: ...
    @property
    def data(self) -> Tensor: ...
    @property
    def array(self) -> Any: ...
    @property
    def grad(self) -> Tensor | None: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def device(self) -> str: ...
    @property
    def grad_fn(self) -> str | None: ...
    @property
    def requires_grad(self) -> bool: ...
    @requires_grad.setter
    def requires_grad(self, value: bool) -> None: ...
    def backward(self) -> None: ...
    def to(self, device: str) -> Variable: ...
    def cleargrad(self) -> None: ...
    def unchain_backward(self) -> None: ...
    def __repr__(self) -> str: ...

class Linear:
    def __init__(self, in_features: int, out_features: int, seed: int = 0, device: str = "cpu") -> None: ...
    def forward(self, x: Variable) -> Variable: ...
    def __call__(self, x: Variable) -> Variable: ...
    def parameters(self) -> list[Variable]: ...
    def cleargrads(self) -> None: ...
    @property
    def W(self) -> Variable: ...
    @property
    def b(self) -> Variable | None: ...

class SGD:
    def __init__(self, lr: float) -> None: ...
    def setup(self, params: list[Variable]) -> None: ...
    def update(self) -> None: ...
    def zero_grad(self) -> None: ...

class Adam:
    def __init__(self, lr: float = 0.001) -> None: ...
    def setup(self, params: list[Variable]) -> None: ...
    def update(self) -> None: ...
    def zero_grad(self) -> None: ...

def relu(x: Variable) -> Variable: ...
def add(a: Variable, b: Variable) -> Variable: ...
def sub(a: Variable, b: Variable) -> Variable: ...
def mul(a: Variable, b: Variable) -> Variable: ...
def div(a: Variable, b: Variable) -> Variable: ...
def sqrt(x: Variable) -> Variable: ...
def neg(x: Variable) -> Variable: ...
def matmul(a: Variable, b: Variable) -> Variable: ...
def transpose(x: Variable) -> Variable: ...
def sum(x: Variable) -> Variable: ...
def mean(x: Variable) -> Variable: ...
def softmax_cross_entropy(logits: Variable, target: Variable) -> Variable: ...
def cuda_available() -> bool: ...
def synchronize(device: str = "cpu") -> None: ...
def vulkan_available() -> bool: ...
def vulkan_devices() -> list[str]: ...
def version() -> str: ...
